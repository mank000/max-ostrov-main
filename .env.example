# Local Docker Compose ports. The base compose.yaml does not require a token.
APP_PORT=8080
MODERATION_PORT=8081

# Required only when using compose.production.yaml and compose.https.yaml.
APP_DOMAIN=
MODERATION_DOMAIN=
KUTEZH_BOT_TOKEN=

# Optional production settings; leave blank unless used.
KUTEZH_SUPPORT_OWNER_MAX_ID=
KUTEZH_MAINTENANCE_ALLOWED_IDS=
KUTEZH_MODELS_DIR=./models
